# ---- MongoDB ----
# Local MongoDB:
MONGODB_URI=mongodb://127.0.0.1:27017/food-corner
# MongoDB Atlas example (replace user, password and cluster):
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/food-corner?retryWrites=true&w=majority

# ---- Server ----
PORT=5000
# Set COOKIE_SECURE=true only when the site is served over HTTPS (production)
COOKIE_SECURE=false

# ---- Session secret: replace with a long random string (the server will not start with this placeholder) ----
SESSION_SECRET=change-this-to-a-long-random-string

# ---- Used ONLY by scripts/createAdmin.js ----
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password
